# Admin password for /admin. Set it as a secret in Cloudflare, never in git:
#   npx wrangler secret put ADMIN_PASSWORD
# No admin login works until this is set. For local development, put it in
# .dev.vars instead (gitignored).
ADMIN_PASSWORD=

# Optional secret used to sign admin session cookies. If unset, ADMIN_PASSWORD
# is used as the signing key instead (changing the password then signs everyone
# out). Set as a secret in Cloudflare:
#   npx wrangler secret put ADMIN_SESSION_SECRET
ADMIN_SESSION_SECRET=

# Canonical public origin, such as https://spoorthigroups.co.in after domain connection.
NEXT_PUBLIC_SITE_URL=https://spoorthigroups.co.in

# Optional notification provider credentials. No email is sent unless an integration is added and configured.
EMAIL_API_KEY=
NOTIFICATION_EMAIL=
