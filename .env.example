# Comma-separated emails allowed to access /admin after ChatGPT sign-in.
ADMIN_EMAILS=

# Canonical public origin, such as https://spoorthigrps.in after domain connection.
NEXT_PUBLIC_SITE_URL=https://spoorthigrps.in

# Optional notification provider credentials. No email is sent unless an integration is added and configured.
EMAIL_API_KEY=
NOTIFICATION_EMAIL=
